     use super::*;
 
+    /// iwmac-vector: an object marked `data-iwdie-fixed` keeps its size and turn - a scale or a
+    /// rotation moves it by its centre - and so does a group of just that object. A group with more
+    /// in it scales, and each fixed object in it moves by its centre.
