+        let fixed = |id: u64, r: Rect| {
+            let mut n = Node::path(NodeId(id), shapes::rectangle(r), Appearance::default_art());
+            n.extras_mut().attrs = Some(Box::new(ObjectAttributes { data: vec![("iwdie-fixed".into(), "1".into())], ..Default::default() }));
+            n
+        };
