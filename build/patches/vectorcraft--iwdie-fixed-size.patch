+/// iwmac-vector: whether every selected object keeps its size
+/// ([`vectorcraft_doc::Node::keeps_size`]): its bounding box then has no handles and no rotate
+/// zones, and a press there moves it.
+pub fn selection_keeps_size(cx: &ToolContext) -> bool {
+    !cx.selection.objects.is_empty() && cx.selection.objects.iter().all(|id| cx.doc.node(*id).is_some_and(|n| n.keeps_size()))
+}
+
