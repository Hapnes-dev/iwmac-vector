+        one.transform(Affine::scale(3.0), false);
+        assert_eq!(one.geometric_bounds(), Some(Rect::new(10.0, 10.0, 20.0, 20.0)));
+        let plain = Node::path(NodeId(4), shapes::rectangle(Rect::new(0.0, 0.0, 10.0, 10.0)), Appearance::default_art());
