+    /// iwmac-vector: whether this object keeps its size and turn. The IWMAC userscript marks so
+    /// (`data-iwdie-fixed="1"`) the objects its Designer draws as a picture of their own size - a
+    /// pump, an alarm, a value's pill - which a resize would only cut off or stretch there. A group
+    /// holding nothing but one such object (a dropped file's) keeps it too. A transform moves such
+    /// an object by its centre and does nothing else ([`Node::transform`]), and the Selection tool
+    /// shows it no handles.
+    pub fn keeps_size(&self) -> bool {
+        if self.extras().attrs.as_ref().is_some_and(|a| a.data.iter().any(|(k, v)| k == "iwdie-fixed" && v != "0")) {
+            return true;
+        }
+        match &self.kind {
+            NodeKind::Group { children, clip: false } => matches!(children.as_slice(), [only] if only.keeps_size()),
+            _ => false,
+        }
+    }
