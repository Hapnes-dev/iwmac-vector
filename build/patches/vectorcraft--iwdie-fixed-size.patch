+        assert_eq!(kids[0].geometric_bounds(), Some(Rect::new(45.0, 5.0, 55.0, 15.0)), "the fixed one moved by its centre");
+        assert_eq!(kids[1].geometric_bounds(), Some(Rect::new(0.0, 0.0, 20.0, 20.0)), "the plain one scaled");
+        let mut zero = fixed(7, Rect::new(0.0, 0.0, 10.0, 10.0));
+        zero.extras_mut().attrs = Some(Box::new(ObjectAttributes { data: vec![("iwdie-fixed".into(), "0".into())], ..Default::default() }));
+        assert!(!zero.keeps_size(), "0 says it may be resized");
